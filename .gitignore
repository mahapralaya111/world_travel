# 大体积运行时（本地大模型，1.8GB）
ollama/

# Python 缓存
__pycache__/
*.pyc

# 日志
*.log

# 本地数据库文件（已用 MySQL）
*.db

# 依赖目录
node_modules/
venv/
.venv/

# 编辑器
.vscode/
.idea/

# 本地文档（不上传 GitHub）
local_docs/
*.docx

# 密钥文件
server/.secret_key
# 本地环境变量（数据库密码等，绝不提交）
.env
.env.local
server/.env.local

# SQLite WAL 模式产生的临时文件
*.db-wal
*.db-shm

# Windows 下 curl -o nul 等误产生的占位文件
nul
